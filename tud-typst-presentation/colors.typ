// TUD corporate colors ("TUD Farben").
// Names follow the official German color names, translated to English.

// --- Main colors ---------------------------------------
#let tud-brilliant-blue = rgb("#00008C") // Brillantblau
#let tud-dark-blue      = rgb("#001450") // Dunkelblau
#let tud-black          = rgb("#000000") // Schwarz
#let tud-gray           = rgb("#323F4B") // Grau 100%
#let tud-white          = rgb("#FFFFFF") // Weiß

// --- Accent colors, strong (index 1) -------------------
#let tud-blue-1    = rgb("#2F57B2") // Blau 1
#let tud-violet-1  = rgb("#7369BE") // Violett 1
#let tud-magenta-1 = rgb("#BC1589") // Magenta 1
#let tud-red-1     = rgb("#D20F41") // Rot 1
#let tud-orange-1  = rgb("#C85000") // Orange 1
#let tud-yellow-1  = rgb("#FFC700") // Gelb 1
#let tud-olive-1   = rgb("#767A23") // Oliv 1
#let tud-green-1   = rgb("#007D4B") // Grün 1
#let tud-teal-1    = rgb("#0A777F") // Türkis 1

// --- Accent colors, light (index 2) --------------------
#let tud-blue-2    = rgb("#97C6FF") // Blau 2
#let tud-violet-2  = rgb("#C8C8FF") // Violett 2
#let tud-magenta-2 = rgb("#FFB9FF") // Magenta 2
#let tud-red-2     = rgb("#FFAAA5") // Rot 2
#let tud-orange-2  = rgb("#FFBE78") // Orange 2
#let tud-yellow-2  = rgb("#FFE483") // Gelb 2
#let tud-olive-2   = rgb("#D2DC46") // Oliv 2
#let tud-green-2   = rgb("#8CE6AA") // Grün 2
#let tud-teal-2    = rgb("#8CE6D7") // Türkis 2

// --- Gradients------------------------------------------
#let tud-gradient = gradient.linear(tud-dark-blue, tud-blue-1, angle: -90deg)